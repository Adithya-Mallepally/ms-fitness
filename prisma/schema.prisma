datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("RECEPTIONIST") // SUPER_ADMIN, RECEPTIONIST, MANAGER
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model Member {
  id               String       @id @default(cuid())
  memberCode       String       @unique
  firstName        String
  lastName         String
  phone            String       @unique
  email            String?
  gender           String       @default("MEN") // MEN, WOMEN, COUPLE
  dob              DateTime?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  photoUrl         String?
  status           String       @default("ACTIVE") // ACTIVE, EXPIRING, EXPIRED, INACTIVE
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships   Membership[]
  payments      Payment[]
  notifications Notification[]
  attendances   Attendance[]
}

model MembershipPlan {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  category       String      // MEN, WOMEN, COUPLE
  durationMonths Int         // 1, 3, 6, 12
  active         Boolean     @default(true)
  description    String?
  createdAt      DateTime    @default(now())

  prices       PlanPrice[]
  memberships  Membership[]
}

model PlanPrice {
  id            String    @id @default(cuid())
  planId        String
  price         Float
  currency      String    @default("INR")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  version       Int       @default(1)
  createdBy     String?
  createdAt     DateTime  @default(now())

  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

model Membership {
  id          String   @id @default(cuid())
  memberId    String
  planId      String
  priceId     String
  startDate   DateTime
  endDate     DateTime
  amountPaid  Float
  status      String   @default("ACTIVE") // ACTIVE, EXPIRING, EXPIRED, CANCELLED
  source      String   @default("NEW_JOIN") // NEW_JOIN, RENEWAL
  createdAt   DateTime @default(now())

  member        Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan          MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  price         PlanPrice      @relation(fields: [priceId], references: [id], onDelete: Cascade)
  payments      Payment[]
  notifications Notification[]
}

model Payment {
  id             String   @id @default(cuid())
  receiptNo      String   @unique
  memberId       String
  membershipId   String
  amount         Float
  paymentMethod  String   @default("UPI") // CASH, UPI, CARD, BANK_TRANSFER
  transactionRef String?
  status         String   @default("PAID") // PAID, PARTIAL, REFUNDED
  paidAt         DateTime @default(now())
  createdBy      String?
  notes          String?

  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String    @id @default(cuid())
  memberId     String
  membershipId String?
  type         String    // EXPIRY_30D, EXPIRY_7D, EXPIRED, WELCOME
  channel      String    @default("IN_APP")
  message      String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    @default("PENDING") // PENDING, SENT, DISMISSED
  createdAt    DateTime  @default(now())

  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String   // FEE_UPDATED, MEMBER_CREATED, PAYMENT_RECORDED, RENEWAL_COMPLETED
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id         String   @id @default(cuid())
  memberId   String
  checkInAt  DateTime @default(now())
  dateString String   // Format: "YYYY-MM-DD"
  shift      String   @default("MORNING") // MORNING, EVENING, GENERAL
  status     String   @default("PRESENT") // PRESENT, WARNING_EXPIRING, OVERRIDE
  verifiedBy String   @default("QR_SCANNER") // QR_SCANNER, DESK_MANUAL
  notes      String?

  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([dateString])
  @@index([memberId])
}

