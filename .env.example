# Database connection string (PostgreSQL for Netlify serverless deployment)
# Example from Neon.tech: postgresql://username:password@ep-cool-frog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"

# Base URL (defaults to localhost:3001 in development, Netlify sets this automatically or use your custom domain)
NEXT_PUBLIC_APP_URL="https://your-site-name.netlify.app"
